SPRING_PROFILES_ACTIVE=hosted
PORT=8080
LEETGRIND_DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}
LEETGRIND_DB_USER=${{MySQL.APP_DB_USER}}
LEETGRIND_DB_PASSWORD=${{MySQL.APP_DB_PASSWORD}}
LEETGRIND_JWT_SECRET=replace-with-generated-base64-key
LEETGRIND_BROWSER_ORIGIN=https://your-app.up.railway.app
# Set true once a working LeetCode data source is configured.
LEETGRIND_PROFILE_PREVIEW_ENABLED=false
# Set a compatible service base URL, or enable permitted direct access below.
LEETGRIND_PROFILE_SERVICE_URL=
LEETGRIND_DIRECT_PROFILE_PREVIEW=false
